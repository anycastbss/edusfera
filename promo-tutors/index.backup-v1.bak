<!doctype html>
<html lang="ru" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>Edusfera.by — Платформа для репетиторов</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

      @font-face {
        font-family: 'Rimma Sans';
        src: url('assets/Rimma_sans-Bold.ttf') format('truetype');
        font-weight: 700;
        font-style: normal;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #f7f7f9;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #0e0f10;
        -webkit-font-smoothing: antialiased;
      }

      #root {
        position: relative;
        width: 100%;
        height: 100%;
        background: #ffffff;
        overflow: hidden;
        perspective: 1400px;
        transform-style: preserve-3d;
      }

      /* 3D Camera Rig */
      #camera-rig {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        will-change: transform;
      }

      /* Ambient Light Mesh Background */
      .ambient-canvas {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }

      .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(110px);
        opacity: 0.7;
        will-change: transform;
      }

      .orb-purple {
        top: -120px;
        right: -80px;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(125, 57, 235, 0.28) 0%, rgba(125, 57, 235, 0) 70%);
      }

      .orb-lime {
        bottom: 120px;
        left: -100px;
        width: 750px;
        height: 750px;
        background: radial-gradient(circle, rgba(198, 255, 51, 0.40) 0%, rgba(198, 255, 51, 0) 70%);
      }

      .orb-coral {
        top: 40%;
        right: -120px;
        width: 650px;
        height: 650px;
        background: radial-gradient(circle, rgba(230, 57, 70, 0.22) 0%, rgba(230, 57, 70, 0) 70%);
      }

      /* Subtle 3D grid with perspective depth */
      .grid-pattern {
        position: absolute;
        inset: -200px;
        background-size: 54px 54px;
        background-image: 
          linear-gradient(to right, rgba(14, 15, 16, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(14, 15, 16, 0.04) 1px, transparent 1px);
        mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
        pointer-events: none;
        z-index: 2;
      }

      /* Base Scene Layer */
      .scene {
        position: absolute;
        inset: 0;
        width: 1080px;
        height: 1920px;
        padding: 96px 64px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transform-style: preserve-3d;
      }

      /* 3D Floating Crystals & Geometric Brand Objects */
      .crystal-3d-wrap {
        position: absolute;
        width: 220px;
        height: 220px;
        transform-style: preserve-3d;
        z-index: 5;
      }

      .crystal-face {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 44px;
        background: linear-gradient(135deg, rgba(125, 57, 235, 0.9) 0%, rgba(198, 255, 51, 0.8) 100%);
        border: 2px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 20px 50px rgba(125, 57, 235, 0.4), inset 0 2px 8px rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .crystal-logo-diamond {
        width: 100px;
        height: 100px;
        background: #c6ff33;
        transform: rotate(45deg);
        box-shadow: 0 0 30px #c6ff33;
        border-radius: 12px;
      }

      /* Typography */
      .pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 30px;
        background: rgba(255, 255, 255, 0.90);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(218, 219, 226, 0.9);
        border-radius: 100px;
        box-shadow: 0 8px 24px rgba(14, 15, 16, 0.06);
        align-self: flex-start;
      }

      .pill-badge .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #7d39eb;
        box-shadow: 0 0 12px rgba(125, 57, 235, 0.8);
      }

      .pill-badge span {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #7d39eb;
      }

      .display-title {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 92px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: #0e0f10;
        margin-top: 36px;
      }

      .display-title .highlight-purple {
        color: #7d39eb;
        position: relative;
        display: inline-block;
      }

      .display-title .highlight-coral {
        color: #d9263e;
        display: inline-block;
      }

      .display-title .clean-q {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        display: inline-block;
      }

      .subtitle-text {
        font-size: 34px;
        font-weight: 500;
        line-height: 1.4;
        color: #4b5563;
        margin-top: 24px;
        max-width: 900px;
      }

      /* SCENE 1 Elements: 3D Floating Hook Cards */
      .s1-hook-container {
        display: flex;
        flex-direction: column;
        gap: 22px;
        margin-top: auto;
        margin-bottom: 60px;
        width: 100%;
        transform-style: preserve-3d;
      }

      .s1-3d-card {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 30px 36px;
        background: #ffffff;
        border-radius: 28px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
        transform-style: preserve-3d;
      }

      .s1-card-icon {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        flex-shrink: 0;
      }

      .s1-card-icon.red {
        background: #ffe9eb;
        color: #d9263e;
      }

      .s1-card-icon.amber {
        background: #fef3c7;
        color: #b45309;
      }

      .s1-card-icon.purple {
        background: #f3e8ff;
        color: #7d39eb;
      }

      .s1-card-text {
        font-size: 32px;
        font-weight: 600;
        color: #111827;
      }

      /* SCENE 2 Elements: 3D Phone with Floating Layers */
      .phone-3d-stage {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform-style: preserve-3d;
        margin-top: 30px;
      }

      .phone-3d-device {
        width: 720px;
        height: 1100px;
        background: #ffffff;
        border-radius: 56px;
        padding: 16px;
        box-shadow: 0 40px 90px -15px rgba(125, 57, 235, 0.28), 0 25px 50px rgba(0, 0, 0, 0.1);
        border: 12px solid #111827;
        position: relative;
        overflow: hidden;
        transform-style: preserve-3d;
      }

      .phone-island {
        position: absolute;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        width: 170px;
        height: 32px;
        background: #111827;
        border-radius: 20px;
        z-index: 20;
      }

      .phone-screen-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        border-radius: 40px;
      }

      /* 3D Floating Depth Badges */
      .badge-3d-floating {
        position: absolute;
        z-index: 35;
        padding: 18px 30px;
        border-radius: 100px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 20px 45px rgba(14, 15, 16, 0.16);
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 26px;
        font-weight: 700;
        transform-style: preserve-3d;
      }

      .badge-verified {
        top: 170px;
        right: 16px;
        color: #047857;
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .badge-rating {
        bottom: 200px;
        left: 16px;
        color: #111827;
      }

      .badge-price {
        top: 520px;
        left: 16px;
        background: #7d39eb;
        color: #c6ff33;
        border-color: #6827d6;
      }

      /* SCENE 3 Elements: Interactive 3D Booking & Live Chat */
      .s3-3d-container {
        display: flex;
        flex-direction: column;
        gap: 26px;
        margin-top: 36px;
        width: 100%;
        transform-style: preserve-3d;
      }

      .chat-bubble-3d {
        background: #ffffff;
        border-radius: 32px;
        padding: 26px 32px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.05);
        display: flex;
        gap: 20px;
        align-items: center;
        transform-style: preserve-3d;
      }

      .chat-avatar {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        background: #eff6ff;
        font-size: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .chat-sender {
        font-size: 20px;
        font-weight: 700;
        color: #2563eb;
      }

      .chat-msg {
        font-size: 24px;
        font-weight: 600;
        color: #111827;
        margin-top: 4px;
      }

      .calendar-3d-widget {
        background: #ffffff;
        border-radius: 36px;
        padding: 40px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.06);
        transform-style: preserve-3d;
      }

      .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
      }

      .calendar-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
      }

      .calendar-sync {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 20px;
        font-weight: 600;
        color: #7d39eb;
        background: #f3e8ff;
        padding: 8px 18px;
        border-radius: 100px;
      }

      .slot-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .slot-card {
        padding: 24px 16px;
        border-radius: 20px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        text-align: center;
        transform-style: preserve-3d;
      }

      .slot-time {
        font-size: 32px;
        font-weight: 700;
        color: #111827;
      }

      .slot-status {
        font-size: 18px;
        font-weight: 600;
        color: #4b5563;
        margin-top: 6px;
      }

      /* 3D Pointer / Finger Tap */
      .pointer-3d {
        position: absolute;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(125, 57, 235, 0.4);
        border: 4px solid #7d39eb;
        pointer-events: none;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(125, 57, 235, 0.6);
      }

      .pointer-ring {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #c6ff33;
        transform: scale(0.4);
      }

      .push-3d-notification {
        background: #ffffff;
        border-radius: 32px;
        padding: 28px 36px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 30px 70px rgba(125, 57, 235, 0.16);
        display: flex;
        gap: 24px;
        align-items: center;
        transform-style: preserve-3d;
      }

      .push-icon {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: #7d39eb;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        flex-shrink: 0;
      }

      .push-title {
        font-size: 26px;
        font-weight: 700;
        color: #111827;
      }

      .push-desc {
        font-size: 22px;
        color: #4b5563;
        margin-top: 4px;
      }

      /* SCENE 4 Elements: 3D Bento Grid */
      .s4-3d-bento-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        margin-top: 50px;
        width: 100%;
        transform-style: preserve-3d;
      }

      .bento-3d-card {
        background: #ffffff;
        border-radius: 36px;
        padding: 44px 36px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 380px;
        transform-style: preserve-3d;
      }

      .bento-3d-card.span-2 {
        grid-column: span 2;
        height: 320px;
        background: linear-gradient(135deg, #7d39eb 0%, #5b21b6 100%);
        color: #ffffff;
        border: none;
        box-shadow: 0 25px 60px rgba(125, 57, 235, 0.35);
      }

      .bento-metric {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 80px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .bento-3d-card.span-2 .bento-metric {
        color: #c6ff33;
      }

      .bento-label {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin-top: 12px;
      }

      .bento-3d-card.span-2 .bento-label {
        color: #ffffff;
      }

      .bento-desc {
        font-size: 22px;
        color: #4b5563;
        line-height: 1.4;
      }

      .bento-card-light-desc {
        font-size: 22px;
        color: #4b5563;
        line-height: 1.4;
      }

      .bento-3d-card.span-2 .bento-desc {
        color: #e9d5ff;
      }

      /* 3D Chip Tag on Card */
      .bento-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 100px;
        background: #c6ff33;
        color: #0e0f10;
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 12px;
      }

      /* SCENE 5 Elements: Final Branding & 3D Logo Climax */
      .s5-center-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: 240px;
        transform-style: preserve-3d;
      }

      .s5-3d-brand-emblem {
        width: 190px;
        height: 190px;
        border-radius: 46px;
        background: #ffffff;
        box-shadow: 0 30px 70px rgba(125, 57, 235, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
        border: 2px solid #ede9fe;
        transform-style: preserve-3d;
      }

      .s5-3d-brand-emblem img {
        width: 125px;
        height: 125px;
      }

      .s5-logo-text {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 114px;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #0e0f10;
      }

      .s5-tagline {
        font-size: 34px;
        font-weight: 600;
        color: #4b5563;
        margin-top: 18px;
        max-width: 820px;
      }

      .s5-cta-btn {
        margin-top: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 30px 64px;
        border-radius: 100px;
        background: #0e0f10;
        color: #ffffff;
        font-size: 32px;
        font-weight: 700;
        box-shadow: 0 20px 50px rgba(14, 15, 16, 0.25);
        border: none;
        transform-style: preserve-3d;
      }

      .s5-cta-btn .btn-arrow {
        color: #c6ff33;
        font-size: 36px;
      }

      .s5-domain-pill {
        margin-top: 40px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        background: #f3f4f6;
        border-radius: 100px;
        font-size: 32px;
        font-weight: 800;
        color: #7d39eb;
        letter-spacing: 0.05em;
        border: 2px solid #e5e7eb;
      }

      /* Floating Feature Capsules in Final Scene */
      .s5-orbit-tags {
        display: flex;
        gap: 16px;
        margin-top: 36px;
        transform-style: preserve-3d;
      }

      .orbit-tag {
        padding: 10px 22px;
        border-radius: 100px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        font-size: 20px;
        font-weight: 700;
        color: #374151;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
      }

      /* Animated progress track at bottom */
      .progress-bar-container {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: rgba(0, 0, 0, 0.04);
        z-index: 100;
      }

      .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(to right, #7d39eb, #d9263e, #c6ff33);
      }
    </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="20"
      data-width="1080"
      data-height="1920"
    >
      <!-- Audio Element for Dynamic Track inside composition root -->
      <audio id="bgm" src="audio_track.mp3" data-start="0" data-duration="20"></audio>

      <!-- Ambient Visuals -->
      <div class="ambient-canvas" data-layout-allow-overflow>
        <div class="ambient-orb orb-purple" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-lime" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-coral" data-layout-allow-overflow></div>
      </div>
      <div class="grid-pattern"></div>

      <!-- MASTER 3D CAMERA RIG -->
      <div id="camera-rig">

        <!-- ================= SCENE 1 (0.0s - 3.4s) — THE HIGH-IMPACT HOOK ================= -->
        <div id="scene1" class="scene">
          <!-- 3D Spinning Brand Crystal in Hook -->
          <div id="s1-crystal" class="crystal-3d-wrap" style="top: 80px; right: 60px; width: 160px; height: 160px;" data-layout-allow-overflow data-layout-allow-occlusion>
            <div class="crystal-face" data-layout-allow-overflow data-layout-allow-occlusion>
              <div class="crystal-logo-diamond" style="width: 70px; height: 70px;"></div>
            </div>
          </div>

          <div style="position: relative; z-index: 20;">
            <div id="s1-badge" class="pill-badge">
              <div class="dot"></div>
              <span>Платформа для репетиторов №1</span>
            </div>

            <h1 id="s1-title" class="display-title" data-layout-allow-occlusion>
              Вы <span class="highlight-coral">репетитор<span class="clean-q">?</span></span>
            </h1>

            <p id="s1-sub" class="subtitle-text">
              Устали вести записи в блокнотах и терять заявки в десятках разных мессенджеров?
            </p>
          </div>

          <div class="s1-hook-container">
            <div id="s1-card1" class="s1-3d-card" data-layout-allow-overflow>
              <div class="s1-card-icon red">✕</div>
              <div class="s1-card-text">Хаос в расписании и накладки уроков</div>
            </div>
            <div id="s1-card2" class="s1-3d-card" data-layout-allow-overflow>
              <div class="s1-card-icon amber">⚠</div>
              <div class="s1-card-text">Отмены занятий в последний момент</div>
            </div>
            <div id="s1-card3" class="s1-3d-card" data-layout-allow-overflow>
              <div class="s1-card-icon purple">✎</div>
              <div class="s1-card-text">Ручной подсчёт оплат и чеков</div>
            </div>
          </div>

          <div style="height: 10px;"></div>
        </div>

        <!-- ================= SCENE 2 (3.4s - 7.6s) — 3D DIGITAL SHOWCASE & CAMERA TILT ================= -->
        <div id="scene2" class="scene">
          <div>
            <div id="s2-badge" class="pill-badge">
              <div class="dot"></div>
              <span>Цифровая витрина</span>
            </div>

            <h2 id="s2-title" class="display-title">
              Создайте свою <span class="highlight-purple">витрину</span>
            </h2>

            <p id="s2-sub" class="subtitle-text">
              Персональный мини-сайт с подтверждёнными дипломами и отзывами учеников.
            </p>
          </div>

          <div class="phone-3d-stage">
            <div id="s2-phone" class="phone-3d-device" data-layout-allow-overflow>
              <div class="phone-island"></div>
              <img class="phone-screen-img" src="assets/tutor_profile.png" alt="Профиль репетитора" />
            </div>

            <!-- 3D Floating Depth Badges -->
            <div id="s2-tag-verified" class="badge-3d-floating badge-verified">
              <span>✓</span> Диплом проверен
            </div>
            <div id="s2-tag-rating" class="badge-3d-floating badge-rating">
              <span>⭐ 5.0</span> (48 отзывов)
            </div>
            <div id="s2-tag-price" class="badge-3d-floating badge-price" data-layout-allow-overflow>
              <span>⚡ Ставка: 35 BYN / ч</span>
            </div>
          </div>
        </div>

        <!-- ================= SCENE 3 (7.6s - 12.2s) — DEEP CAMERA FLY-THROUGH & INTERACTIVE BOOKING ================= -->
        <div id="scene3" class="scene">
          <div>
            <div id="s3-badge" class="pill-badge">
              <div class="dot"></div>
              <span>Автоматизация</span>
            </div>

            <h2 id="s3-title" class="display-title">
              Запись, расписание <br />и связь <span class="highlight-purple">в один клик</span>
            </h2>

            <p id="s3-sub" class="subtitle-text">
              Ученики сами выбирают свободные окна в вашем календаре. Без лишней переписки.
            </p>
          </div>

          <div class="s3-3d-container">
            <!-- Live chat bubble -->
            <div id="s3-chat" class="chat-bubble-3d">
              <div class="chat-avatar">👨‍🎓</div>
              <div>
                <div class="chat-sender">Артём • Ученик (ЦТ/ЦЭ)</div>
                <div class="chat-msg">«Здравствуйте! Хочу записаться на подготовку по математике»</div>
              </div>
            </div>

            <div id="s3-calendar" class="calendar-3d-widget">
              <div class="calendar-header">
                <div class="calendar-title">Пятница, 24 октября</div>
                <div class="calendar-sync">Синхронизировано ✓</div>
              </div>

              <div class="slot-grid">
                <div id="slot-1" class="slot-card">
                  <div class="slot-time">15:00</div>
                  <div class="slot-status">Свободно</div>
                </div>
                <div id="slot-2" class="slot-card">
                  <div class="slot-time">16:30</div>
                  <div class="slot-status">Свободно</div>
                </div>
                <div id="slot-3" class="slot-card">
                  <div class="slot-time">18:00</div>
                  <div class="slot-status">Свободно</div>
                </div>
              </div>
            </div>

            <!-- 3D Pointer / Tap interaction -->
            <div id="s3-pointer" class="pointer-3d" style="top: 250px; left: 620px; opacity: 0;" data-layout-allow-overflow>
              <div class="pointer-ring"></div>
            </div>

            <!-- Push notification pop-up -->
            <div id="s3-push" class="push-3d-notification">
              <div class="push-icon">⚡</div>
              <div>
                <div class="push-title">Новая запись на занятие!</div>
                <div class="push-desc">Артём записался на 18:00 • Подготовка к ЦТ • 0 BYN комиссии</div>
              </div>
            </div>
          </div>

          <div style="height: 10px;"></div>
        </div>

        <!-- ================= SCENE 4 (12.2s - 16.5s) — 3D ISOMETRIC BENTO GRID ================= -->
        <div id="scene4" class="scene">
          <div>
            <div id="s4-badge" class="pill-badge">
              <div class="dot"></div>
              <span>Свобода и доход</span>
            </div>

            <h2 id="s4-title" class="display-title">
              Меньше рутины.<br />
              <span class="highlight-coral">Больше времени</span> ученикам
            </h2>

            <p id="s4-sub" class="subtitle-text">
              Сфокусируйтесь на обучении, а сервисы платформы возьмут рутину на себя.
            </p>
          </div>

          <div class="s4-3d-bento-grid">
            <div id="s4-bento-hero" class="bento-3d-card span-2" data-layout-allow-overflow>
              <div>
                <div class="bento-chip">💎 100% ДОХОД</div>
                <div class="bento-metric">0 BYN</div>
                <div class="bento-label">Комиссия за проведённые уроки</div>
              </div>
              <div class="bento-desc">Вы получаете 100% оплаты от ваших учеников напрямую</div>
            </div>

            <div id="s4-bento-npd" class="bento-3d-card">
              <div>
                <div class="bento-metric" style="color: #7d39eb;">100%</div>
                <div class="bento-label">Авто-чеки НПД</div>
              </div>
              <div class="bento-card-light-desc">Автоматическая выгрузка чеков в налоговую</div>
            </div>

            <div id="s4-bento-time" class="bento-3d-card">
              <div>
                <div class="bento-metric" style="color: #d9263e;">+5 ч</div>
                <div class="bento-label">Экономия времени</div>
              </div>
              <div class="bento-card-light-desc">Каждую неделю без бумажной волокиты</div>
            </div>
          </div>

          <div style="height: 30px;"></div>
        </div>

        <!-- ================= SCENE 5 (16.5s - 20.0s) — 3D LOGO CLIMAX & CTA ================= -->
        <div id="scene5" class="scene">
          <div class="s5-center-wrap">
            <div id="s5-mark" class="s5-3d-brand-emblem">
              <img src="assets/logo.svg" alt="Логотип Edusfera" />
            </div>

            <h2 id="s5-name" class="s5-logo-text">EDUSFERA</h2>

            <p id="s5-tagline" class="s5-tagline">
              Современная образовательная платформа для репетиторов Беларуси
            </p>

            <div id="s5-orbit" class="s5-orbit-tags">
              <div class="orbit-tag">0 BYN комиссии</div>
              <div class="orbit-tag">Авто-НПД</div>
              <div class="orbit-tag">Онлайн-запись</div>
            </div>

            <div id="s5-btn" class="s5-cta-btn">
              <span>Создать витрину бесплатно</span>
              <span class="btn-arrow">→</span>
            </div>

            <div id="s5-url" class="s5-domain-pill">
              edusfera.by
            </div>
          </div>
        </div>

      </div><!-- /camera-rig -->

      <!-- Bottom Progress Track -->
      <div class="progress-bar-container">
        <div id="timeline-progress" class="progress-bar-fill"></div>
      </div>
    </div>

    <!-- GSAP Master Timeline Controller -->
    <script>
      const tl = gsap.timeline({ paused: true });

      // Progress bar fill across the entire 20s
      tl.to("#timeline-progress", { width: "100%", duration: 20.0, ease: "none" }, 0);

      // ================= MASTER 3D CAMERA RIG MOVEMENTS =================
      tl.set("#camera-rig", { z: 0, rotationX: 0, rotationY: 0 }, 0);

      // Beat 1 (0-3.4s): Camera pushes in with subtle pitch
      tl.to("#camera-rig", { z: 70, rotationX: 3, duration: 3.4, ease: "power1.inOut" }, 0);

      // Beat 2 (3.4-7.6s): Camera swoops into 3D isometric view
      tl.to("#camera-rig", { z: 35, rotationY: 0, rotationX: 0, duration: 4.2, ease: "power2.out" }, 3.4);

      // Beat 3 (7.6-12.2s): Deep push into calendar & chat
      tl.to("#camera-rig", { z: 50, rotationX: 0, rotationY: 0, duration: 4.6, ease: "power1.inOut" }, 7.6);

      // Beat 4 (12.2-16.5s): Camera sweeping across 3D bento
      tl.to("#camera-rig", { z: 25, rotationY: -3, rotationX: 2, duration: 4.3, ease: "power2.out" }, 12.2);

      // Beat 5 (16.5-20.0s): Hero zoom-through into final logo lockup
      tl.to("#camera-rig", { z: 0, rotationX: 0, rotationY: 0, duration: 3.5, ease: "power3.out" }, 16.5);


      // ================= SCENE 1 (0.0s - 3.4s) — THE HIGH-IMPACT HOOK =================
      tl.fromTo("#scene1", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 0);
      
      // 3D Spinning Brand Crystal in Hook
      tl.fromTo("#s1-crystal", 
        { opacity: 0, scale: 0.2, rotationY: -180, rotationX: 90, z: -300 }, 
        { opacity: 1, scale: 1, rotationY: 25, rotationX: 15, z: 80, duration: 1.2, ease: "back.out(1.8)" }, 
        0.1
      );
      tl.to("#s1-crystal", { rotationY: 120, rotationX: -10, duration: 2.0, ease: "power1.inOut" }, 1.3);

      // Kinetic Title and Badge
      tl.fromTo("#s1-badge", { opacity: 0, y: -30, z: 50 }, { opacity: 1, y: 0, z: 0, duration: 0.5, ease: "back.out(1.7)" }, 0.1);
      tl.fromTo("#s1-title", { opacity: 0, y: 40, scale: 0.85, z: 80 }, { opacity: 1, y: 0, scale: 1, z: 0, duration: 0.7, ease: "power3.out" }, 0.25);
      tl.fromTo("#s1-sub", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0.5);

      // 3D Staggered Pain Cards with 3D tilt
      tl.fromTo("#s1-card1", 
        { opacity: 0, x: -90, rotationY: 20, z: -100 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 0, duration: 0.5, ease: "back.out(1.5)" }, 
        0.8
      );
      tl.fromTo("#s1-card2", 
        { opacity: 0, x: -90, rotationY: 20, z: -100 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 0, duration: 0.5, ease: "back.out(1.5)" }, 
        1.1
      );
      tl.fromTo("#s1-card3", 
        { opacity: 0, x: -90, rotationY: 20, z: -100 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 0, duration: 0.5, ease: "back.out(1.5)" }, 
        1.4
      );

      // Micro-beat punch at 2.4s (cards react to tension)
      tl.to(["#s1-card1", "#s1-card2", "#s1-card3"], { scale: 1.03, duration: 0.2, yoyo: true, repeat: 1 }, 2.4);

      // Scene 1 Out (Camera blasts forward, cards fly past camera)
      tl.to("#s1-card1", { z: 400, opacity: 0, duration: 0.4, ease: "power3.in" }, 3.0);
      tl.to("#s1-card2", { z: 450, opacity: 0, duration: 0.4, ease: "power3.in" }, 3.1);
      tl.to("#s1-card3", { z: 500, opacity: 0, duration: 0.4, ease: "power3.in" }, 3.2);
      tl.to("#s1-crystal", { z: 500, scale: 2.0, opacity: 0, duration: 0.35, ease: "power3.in" }, 3.05);
      tl.to("#scene1", { opacity: 0, duration: 0.3 }, 3.3);


      // ================= SCENE 2 (3.4s - 7.6s) — 3D DIGITAL SHOWCASE =================
      tl.fromTo("#scene2", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 3.4);
      tl.fromTo("#s2-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 3.5);
      tl.fromTo("#s2-title", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, 3.6);
      tl.fromTo("#s2-sub", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 3.8);

      // 3D Phone swoops in from isometric angle with multi-axis rotation
      tl.fromTo("#s2-phone", 
        { opacity: 0, y: 260, rotationY: 28, rotationX: 18, z: -250, scale: 0.8 }, 
        { opacity: 1, y: 0, rotationY: -8, rotationX: 6, z: 30, scale: 1, duration: 1.2, ease: "power3.out" }, 
        3.7
      );
      // Continuous camera sweep over phone
      tl.to("#s2-phone", { rotationY: 6, rotationX: 2, z: 45, duration: 2.0, ease: "power1.inOut" }, 4.9);

      // 3D Floating Badges popping out with extreme depth (translateZ)
      tl.fromTo("#s2-tag-verified", 
        { opacity: 0, scale: 0.4, z: -100, x: 60 }, 
        { opacity: 1, scale: 1, z: 120, x: 0, duration: 0.6, ease: "back.out(2)" }, 
        4.4
      );
      tl.fromTo("#s2-tag-rating", 
        { opacity: 0, scale: 0.4, z: -100, x: -60 }, 
        { opacity: 1, scale: 1, z: 140, x: 0, duration: 0.6, ease: "back.out(2)" }, 
        4.8
      );
      tl.fromTo("#s2-tag-price", 
        { opacity: 0, scale: 0.4, z: -100, y: 40 }, 
        { opacity: 1, scale: 1, z: 160, y: 0, duration: 0.6, ease: "back.out(2)" }, 
        5.2
      );

      // Subtle float oscillation of badges
      tl.to("#s2-tag-verified", { y: -12, duration: 1.0, yoyo: true, repeat: 1, ease: "sine.inOut" }, 5.0);
      tl.to("#s2-tag-rating", { y: 12, duration: 1.0, yoyo: true, repeat: 1, ease: "sine.inOut" }, 5.4);

      // Scene 2 Out (Camera dives through the phone screen into calendar)
      tl.to("#s2-tag-verified", { z: 400, opacity: 0, duration: 0.35 }, 7.05);
      tl.to("#s2-tag-rating", { z: 400, opacity: 0, duration: 0.35 }, 7.1);
      tl.to("#s2-tag-price", { z: 400, opacity: 0, duration: 0.35 }, 7.1);
      tl.to("#s2-phone", { scale: 1.8, z: 350, opacity: 0, duration: 0.45, ease: "power2.in" }, 7.05);
      tl.to("#scene2", { opacity: 0, duration: 0.3 }, 7.4);


      // ================= SCENE 3 (7.6s - 12.2s) — DEEP ZOOM & LIVE BOOKING =================
      tl.fromTo("#scene3", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 7.6);
      tl.fromTo("#s3-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 7.7);
      tl.fromTo("#s3-title", { opacity: 0, y: 30, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "power3.out" }, 7.8);
      tl.fromTo("#s3-sub", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 8.0);

      // Student chat drops in with 3D spring
      tl.fromTo("#s3-chat", 
        { opacity: 0, y: -40, z: -100, rotationX: 20 }, 
        { opacity: 1, y: 0, z: 40, rotationX: 0, duration: 0.6, ease: "back.out(1.6)" }, 
        8.1
      );

      // Calendar 3D Box emerges with depth
      tl.fromTo("#s3-calendar", 
        { opacity: 0, y: 60, z: -150, scale: 0.9 }, 
        { opacity: 1, y: 0, z: 20, scale: 1, duration: 0.7, ease: "power3.out" }, 
        8.4
      );

      // Slots arrive in rapid succession
      tl.fromTo("#slot-1", { opacity: 0, y: 20, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)" }, 8.7);
      tl.fromTo("#slot-2", { opacity: 0, y: 20, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)" }, 8.9);
      tl.fromTo("#slot-3", { opacity: 0, y: 20, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)" }, 9.1);

      // Pointer / Tap Animation
      tl.fromTo("#s3-pointer", 
        { opacity: 0, scale: 2.0, x: 40, y: 40 }, 
        { opacity: 1, scale: 1.0, x: 0, y: 0, duration: 0.4, ease: "power2.out" }, 
        9.5
      );
      tl.to("#s3-pointer", { scale: 0.7, duration: 0.15, ease: "power1.in" }, 9.9);
      tl.to("#s3-pointer", { scale: 1.2, opacity: 0, duration: 0.25, ease: "power1.out" }, 10.05);

      // Slot 3 click state explosion
      tl.to("#slot-3", { 
        scale: 1.08, 
        backgroundColor: "#c6ff33", 
        borderColor: "#0e0f10", 
        z: 30,
        duration: 0.2, 
        ease: "back.out(2)" 
      }, 10.05);
      tl.set("#slot-3 .slot-status", { textContent: "Забронировано ✓", color: "#0e0f10" }, 10.05);

      // Instant 3D Push notification blast towards camera
      tl.fromTo("#s3-push", 
        { opacity: 0, y: 70, z: -80, scale: 0.8 }, 
        { opacity: 1, y: 0, z: 80, scale: 1, duration: 0.6, ease: "back.out(1.8)" }, 
        10.3
      );
      tl.to("#s3-push", { scale: 1.03, duration: 0.8, yoyo: true, repeat: 1, ease: "sine.inOut" }, 10.9);

      // Scene 3 Out (Whip transition to Scene 4)
      tl.to("#scene3", { x: -80, rotationY: -15, opacity: 0, duration: 0.4, ease: "power2.in" }, 11.9);


      // ================= SCENE 4 (12.2s - 16.5s) — 3D ISOMETRIC BENTO GRID =================
      tl.fromTo("#scene4", { opacity: 0, x: 80, rotationY: 15 }, { opacity: 1, x: 0, rotationY: 0, duration: 0.4, ease: "power2.out" }, 12.2);
      tl.fromTo("#s4-badge", { opacity: 0, y: -15 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 12.3);
      tl.fromTo("#s4-title", { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, 12.4);
      tl.fromTo("#s4-sub", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 12.6);

      // 3D Bento cards staggered arrival with 3D elevation
      tl.fromTo("#s4-bento-hero", 
        { opacity: 0, y: 60, z: -120, rotationX: 15 }, 
        { opacity: 1, y: 0, z: 40, rotationX: 0, duration: 0.7, ease: "back.out(1.6)" }, 
        12.8
      );
      tl.fromTo("#s4-bento-npd", 
        { opacity: 0, y: 50, z: -100, rotationY: 12 }, 
        { opacity: 1, y: 0, z: 20, rotationY: 0, duration: 0.6, ease: "back.out(1.5)" }, 
        13.2
      );
      tl.fromTo("#s4-bento-time", 
        { opacity: 0, y: 50, z: -100, rotationY: -12 }, 
        { opacity: 1, y: 0, z: 20, rotationY: 0, duration: 0.6, ease: "back.out(1.5)" }, 
        13.4
      );

      // Bento cards dynamic tilt oscillation
      tl.to("#s4-bento-hero", { z: 55, duration: 1.0, yoyo: true, repeat: 1, ease: "sine.inOut" }, 13.7);

      // Scene 4 Out (Camera zooms through bento center)
      tl.to("#s4-bento-hero", { scale: 1.4, z: 300, opacity: 0, duration: 0.4, ease: "power2.in" }, 16.05);
      tl.to(["#s4-bento-npd", "#s4-bento-time"], { scale: 0.8, opacity: 0, duration: 0.3 }, 16.15);
      tl.to("#scene4", { opacity: 0, duration: 0.3 }, 16.3);


      // ================= SCENE 5 (16.5s - 20.0s) — 3D LOGO CLIMAX & CTA =================
      tl.fromTo("#scene5", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 16.5);
      
      // 3D Brand Emblem spins and locks in with powerful recoil
      tl.fromTo("#s5-mark", 
        { opacity: 0, scale: 0.2, rotationY: -220, rotationX: 45, z: -300 }, 
        { opacity: 1, scale: 1, rotationY: 0, rotationX: 0, z: 60, duration: 0.9, ease: "back.out(2.2)" }, 
        16.6
      );

      // Logo title, tagline and orbit tags
      tl.fromTo("#s5-name", { opacity: 0, y: 35, scale: 0.85, z: 40 }, { opacity: 1, y: 0, scale: 1, z: 0, duration: 0.7, ease: "power3.out" }, 16.9);
      tl.fromTo("#s5-tagline", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 17.2);

      // Orbit tags stagger in
      tl.fromTo(".orbit-tag", 
        { opacity: 0, scale: 0.5, y: 20 }, 
        { opacity: 1, scale: 1, y: 0, stagger: 0.1, duration: 0.5, ease: "back.out(1.7)" }, 
        17.4
      );

      // 3D Glowing CTA Button with energetic pop
      tl.fromTo("#s5-btn", 
        { opacity: 0, scale: 0.7, y: 40, z: 80 }, 
        { opacity: 1, scale: 1, y: 0, z: 40, duration: 0.6, ease: "back.out(1.8)" }, 
        17.8
      );
      tl.fromTo("#s5-url", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 18.2);

      // Continuous CTA button arrow pulse and emblem breathing
      tl.to(".btn-arrow", { x: 10, repeat: 3, yoyo: true, duration: 0.25, ease: "power1.inOut" }, 18.4);
      tl.to("#s5-mark", { rotationY: 15, duration: 1.5, yoyo: true, repeat: 1, ease: "sine.inOut" }, 17.6);

      // Register master timeline
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
