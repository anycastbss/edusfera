<!doctype html>
<html lang="ru" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>EDUSFERA.BY — Платформа для репетиторов</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

      @font-face {
        font-family: 'Rimma Sans';
        src: url('assets/Rimma_sans-Bold.ttf') format('truetype');
        font-weight: 700;
        font-style: normal;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #0e0f10;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #0e0f10;
        -webkit-font-smoothing: antialiased;
      }

      #root {
        position: relative;
        width: 1080px;
        height: 1920px;
        background: #ffffff;
        overflow: hidden;
        perspective: 1600px;
        transform-style: preserve-3d;
      }

      /* Master Camera Rig with 3D Depth */
      #camera-rig {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        will-change: transform;
      }

      /* Ambient Light Canvas */
      .ambient-canvas {
        position: absolute;
        inset: -200px;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }

      .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.65;
        will-change: transform;
      }

      .orb-purple {
        top: -100px;
        right: -100px;
        width: 850px;
        height: 850px;
        background: radial-gradient(circle, rgba(125, 57, 235, 0.35) 0%, rgba(125, 57, 235, 0) 70%);
      }

      .orb-lime {
        bottom: 50px;
        left: -150px;
        width: 820px;
        height: 820px;
        background: radial-gradient(circle, rgba(198, 255, 51, 0.35) 0%, rgba(198, 255, 51, 0) 70%);
      }

      .orb-coral {
        top: 38%;
        right: -120px;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(217, 38, 62, 0.22) 0%, rgba(217, 38, 62, 0) 70%);
      }

      /* Subtle Grid Texture */
      .grid-pattern {
        position: absolute;
        inset: -200px;
        background-size: 54px 54px;
        background-image: 
          linear-gradient(to right, rgba(14, 15, 16, 0.035) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(14, 15, 16, 0.035) 1px, transparent 1px);
        mask-image: radial-gradient(ellipse at center, black 50%, transparent 85%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 50%, transparent 85%);
        pointer-events: none;
        z-index: 2;
      }

      /* Universal Scene Shell */
      .scene {
        position: absolute;
        inset: 0;
        width: 1080px;
        height: 1920px;
        padding: 96px 64px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transform-style: preserve-3d;
      }

      /* Premium Glassmorphic Badge */
      .pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 28px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(218, 219, 226, 0.95);
        border-radius: 100px;
        box-shadow: 0 10px 30px rgba(14, 15, 16, 0.06);
        align-self: flex-start;
      }

      .pill-badge .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #7d39eb;
        box-shadow: 0 0 14px rgba(125, 57, 235, 0.85);
      }

      .pill-badge span {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: #0e0f10;
      }

      /* Display Titles */
      .display-title {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 80px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin-top: 24px;
        color: #0e0f10;
      }

      .highlight-purple {
        color: #7d39eb;
      }

      .highlight-coral {
        color: #d9263e;
      }

      /* ================= SCENE 01 — THE HOOK (0.0s - 2.5s) ================= */
      .hook-stage {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        height: 100%;
        transform-style: preserve-3d;
        padding-left: 20px;
      }

      .hook-line-wrap {
        overflow: hidden;
        margin-bottom: -15px;
      }

      .hook-word {
        font-family: 'Rimma Sans', sans-serif;
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 0.95;
        display: inline-block;
        will-change: transform, opacity;
      }

      .hook-word.word-1 {
        font-size: 168px;
        color: #0e0f10;
      }

      .hook-word.word-2 {
        font-size: 176px;
        color: #7d39eb;
        text-shadow: 0 10px 40px rgba(125, 57, 235, 0.35);
      }

      .hook-word.word-3 {
        font-size: 154px;
        color: #0e0f10;
      }

      .hook-sub-pill {
        margin-top: 50px;
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 20px 40px;
        background: #0e0f10;
        color: #ffffff;
        border-radius: 100px;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: 0.05em;
        box-shadow: 0 20px 50px rgba(14, 15, 16, 0.25);
      }

      .hook-sub-pill .fire-icon {
        color: #c6ff33;
        font-size: 30px;
      }

      /* ================= SCENE 02 — THE PAIN (2.5s - 5.0s) ================= */
      .pain-stage {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        transform-style: preserve-3d;
      }

      .pain-cards-cluster {
        display: flex;
        flex-direction: column;
        gap: 28px;
        margin-top: 40px;
        position: relative;
        transform-style: preserve-3d;
      }

      .pain-card-item {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 2px solid rgba(229, 231, 235, 0.9);
        border-radius: 28px;
        padding: 32px 36px;
        box-shadow: 0 20px 50px rgba(14, 15, 16, 0.08);
        display: flex;
        align-items: center;
        gap: 24px;
        transform-style: preserve-3d;
        will-change: transform, opacity;
      }

      .pain-icon-badge {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        flex-shrink: 0;
      }

      .pain-icon-badge.blue {
        background: #eff6ff;
        color: #2563eb;
      }

      .pain-icon-badge.red {
        background: #fef2f2;
        color: #dc2626;
      }

      .pain-icon-badge.amber {
        background: #fffbeb;
        color: #d97706;
      }

      .pain-card-text {
        font-size: 28px;
        font-weight: 600;
        color: #1f2937;
        line-height: 1.35;
      }

      .pain-impact-banner {
        margin-top: 36px;
        background: #d9263e;
        color: #ffffff;
        font-family: 'Rimma Sans', sans-serif;
        font-size: 42px;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-align: center;
        padding: 24px 36px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(217, 38, 62, 0.35);
        will-change: transform;
      }

      /* ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION (5.0s - 13.0s) ================= */
      .phone-showcase-stage {
        position: relative;
        width: 100%;
        height: 1240px;
        display: flex;
        align-items: center;
        justify-content: center;
        transform-style: preserve-3d;
      }

      .phone-mockup-frame {
        position: relative;
        width: 620px;
        height: 1140px;
        background: #0e0f10;
        border-radius: 56px;
        padding: 14px;
        box-shadow: 
          0 50px 100px -20px rgba(14, 15, 16, 0.45),
          0 30px 60px -10px rgba(125, 57, 235, 0.25),
          inset 0 0 0 3px rgba(255, 255, 255, 0.15);
        transform-style: preserve-3d;
        will-change: transform;
      }

      .phone-dynamic-island {
        position: absolute;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        width: 140px;
        height: 34px;
        background: #000000;
        border-radius: 20px;
        z-index: 50;
      }

      .phone-inner-screen {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        border-radius: 44px;
        overflow: hidden;
        display: block;
        background: #ffffff;
      }

      /* Floating Spatial 3D Badges */
      .floating-3d-tag {
        position: absolute;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 2px solid rgba(229, 231, 235, 0.95);
        padding: 20px 30px;
        border-radius: 24px;
        font-size: 26px;
        font-weight: 700;
        color: #0e0f10;
        box-shadow: 0 20px 40px rgba(14, 15, 16, 0.14);
        display: flex;
        align-items: center;
        gap: 14px;
        z-index: 60;
        transform-style: preserve-3d;
        will-change: transform, opacity;
      }

      .floating-3d-tag span {
        color: #7d39eb;
        font-size: 28px;
      }

      .tag-pos-verified {
        top: 140px;
        right: -20px;
      }

      .tag-pos-rating {
        top: 380px;
        left: -30px;
      }

      .tag-pos-price {
        bottom: 220px;
        right: -20px;
      }

      /* Interactive Live Schedule Overlay */
      .action-demo-box {
        position: absolute;
        bottom: 40px;
        width: 820px;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 2px solid rgba(125, 57, 235, 0.3);
        border-radius: 36px;
        padding: 34px 40px;
        box-shadow: 0 30px 80px rgba(125, 57, 235, 0.22);
        z-index: 70;
        opacity: 0;
        transform-style: preserve-3d;
        will-change: transform, opacity;
      }

      .action-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }

      .action-header-title {
        font-size: 28px;
        font-weight: 800;
        color: #0e0f10;
      }

      .action-sync-tag {
        font-size: 20px;
        font-weight: 700;
        color: #059669;
        background: #ecfdf5;
        padding: 8px 18px;
        border-radius: 100px;
        border: 1px solid #a7f3d0;
      }

      .action-slots-row {
        display: flex;
        gap: 16px;
      }

      .action-slot {
        flex: 1;
        background: #f9fafb;
        border: 2px solid #e5e7eb;
        border-radius: 20px;
        padding: 18px 12px;
        text-align: center;
      }

      .action-slot-time {
        font-size: 26px;
        font-weight: 800;
        color: #111827;
      }

      .action-slot-lbl {
        font-size: 18px;
        font-weight: 600;
        color: #6b7280;
        margin-top: 4px;
      }

      .student-booking-toast {
        margin-top: 24px;
        background: #0e0f10;
        border-radius: 22px;
        padding: 22px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
        color: #ffffff;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
      }

      .toast-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #c6ff33;
        color: #0e0f10;
        font-size: 26px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .toast-title {
        font-size: 24px;
        font-weight: 700;
      }

      .toast-desc {
        font-size: 19px;
        color: #9ca3af;
        margin-top: 2px;
      }

      /* ================= SCENE 05 — THE EMOTIONAL PAYOFF (13.0s - 17.0s) ================= */
      .payoff-wrap {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        text-align: center;
        padding: 0 20px;
        transform-style: preserve-3d;
      }

      .payoff-slogan-line {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 140px;
        font-weight: 700;
        line-height: 0.96;
        letter-spacing: -0.04em;
        display: block;
        will-change: transform, opacity;
      }

      .payoff-slogan-line.purple {
        color: #7d39eb;
        text-shadow: 0 15px 50px rgba(125, 57, 235, 0.3);
      }

      .payoff-slogan-line.dark {
        color: #0e0f10;
      }

      .payoff-divider {
        width: 140px;
        height: 8px;
        background: #c6ff33;
        border-radius: 10px;
        margin: 52px auto;
        box-shadow: 0 0 24px rgba(198, 255, 51, 0.6);
      }

      .payoff-sub-message {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 60px;
        font-weight: 700;
        color: #0e0f10;
        letter-spacing: -0.02em;
        line-height: 1.15;
        max-width: 880px;
        will-change: transform, opacity;
      }

      .payoff-caption {
        font-size: 32px;
        font-weight: 500;
        color: #4b5563;
        margin-top: 28px;
        max-width: 820px;
        line-height: 1.45;
        will-change: transform, opacity;
      }

      /* ================= SCENE 06 — THE BRAND FINALE (17.0s - 20.0s) ================= */
      .finale-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: 220px;
        transform-style: preserve-3d;
      }

      .finale-brand-mark {
        width: 200px;
        height: 200px;
        border-radius: 48px;
        background: #ffffff;
        box-shadow: 0 30px 80px rgba(125, 57, 235, 0.28);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 44px;
        border: 2px solid #ede9fe;
        transform-style: preserve-3d;
        will-change: transform, opacity;
      }

      .finale-brand-mark img {
        width: 135px;
        height: 135px;
      }

      .finale-logo-wordmark {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 118px;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #0e0f10;
        will-change: transform, opacity;
      }

      .finale-tagline {
        font-size: 36px;
        font-weight: 600;
        color: #4b5563;
        margin-top: 18px;
        max-width: 820px;
        will-change: transform, opacity;
      }

      .finale-feature-row {
        display: flex;
        gap: 18px;
        margin-top: 40px;
      }

      .feature-capsule {
        padding: 12px 26px;
        border-radius: 100px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        font-size: 22px;
        font-weight: 700;
        color: #374151;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
        will-change: transform, opacity;
      }

      .finale-cta-btn {
        margin-top: 64px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 32px 70px;
        border-radius: 100px;
        background: #0e0f10;
        color: #ffffff;
        font-size: 34px;
        font-weight: 700;
        box-shadow: 0 25px 60px rgba(14, 15, 16, 0.3);
        border: none;
        transform-style: preserve-3d;
        will-change: transform;
      }

      .finale-cta-btn .cta-arrow {
        color: #c6ff33;
        font-size: 38px;
        display: inline-block;
      }

      .finale-domain-badge {
        margin-top: 40px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 40px;
        background: #f3f4f6;
        border-radius: 100px;
        font-size: 32px;
        font-weight: 800;
        color: #7d39eb;
        letter-spacing: 0.05em;
        border: 2px solid #e5e7eb;
      }

      /* Progress Bar */
      .progress-bar-container {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: rgba(0, 0, 0, 0.04);
        z-index: 100;
      }

      .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(to right, #7d39eb, #d9263e, #c6ff33);
      }
    </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="20"
      data-width="1080"
      data-height="1920"
    >
      <!-- Background Audio Track -->
      <audio id="bgm" src="audio_track.mp3" data-start="0" data-duration="20"></audio>

      <!-- Ambient Lighting -->
      <div class="ambient-canvas" data-layout-allow-overflow>
        <div class="ambient-orb orb-purple" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-lime" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-coral" data-layout-allow-overflow></div>
      </div>
      <div class="grid-pattern"></div>

      <!-- MASTER 3D CAMERA RIG -->
      <div id="camera-rig">

        <!-- ================= SCENE 01 — THE HOOK (0.0s - 2.5s) ================= -->
        <div id="scene1" class="scene">
          <div class="hook-stage">
            <div class="hook-line-wrap" data-layout-allow-overflow>
              <div id="h-word-1" class="hook-word word-1" data-layout-allow-overflow data-layout-allow-occlusion>ХВАТИТ</div>
            </div>
            <div class="hook-line-wrap" data-layout-allow-overflow>
              <div id="h-word-2" class="hook-word word-2" data-layout-allow-overflow data-layout-allow-occlusion>ТОНУТЬ</div>
            </div>
            <div class="hook-line-wrap" data-layout-allow-overflow>
              <div id="h-word-3" class="hook-word word-3" data-layout-allow-overflow data-layout-allow-occlusion>В РУТИНЕ.</div>
            </div>

            <div id="h-pill" class="hook-sub-pill" data-layout-allow-overflow>
              <span class="fire-icon">⚡</span>
              <span>EDUSFERA ДЛЯ РЕПЕТИТОРОВ</span>
            </div>
          </div>
        </div>

        <!-- ================= SCENE 02 — THE PAIN (2.5s - 5.0s) ================= -->
        <div id="scene2" class="scene">
          <div class="pain-stage">
            <div>
              <div id="p-badge" class="pill-badge">
                <div class="dot"></div>
                <span>Знакомая ситуация?</span>
              </div>
              <h2 id="p-title" class="display-title">
                Уроки. Сообщения.<br />
                <span class="highlight-coral">Расписание.</span>
              </h2>
            </div>

            <div class="pain-cards-cluster">
              <div id="p-card-1" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge blue">💬</div>
                <div class="pain-card-text">«Перенесите урок на 19:30, пожалуйста!»</div>
              </div>
              <div id="p-card-2" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge red">📅</div>
                <div class="pain-card-text">Накладка: 2 ученика записались на 17:00</div>
              </div>
              <div id="p-card-3" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge amber">💳</div>
                <div class="pain-card-text">Снова забыли скинуть чек об оплате...</div>
              </div>

              <div id="p-banner" class="pain-impact-banner" data-layout-allow-overflow>
                СЛИШКОМ МНОГО РУТИНЫ
              </div>
            </div>
          </div>
        </div>

        <!-- ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION (5.0s - 13.0s) ================= -->
        <div id="scene3" class="scene">
          <div>
            <div id="t-badge" class="pill-badge">
              <div class="dot"></div>
              <span id="t-badge-text">Знакомьтесь: Edusfera</span>
            </div>
            <h2 id="t-title" class="display-title">
              <span id="t-title-line1">Ваша цифровая</span><br />
              <span id="t-title-line2" class="highlight-purple">витрина</span>
            </h2>
          </div>

          <div class="phone-showcase-stage">
            <div id="phone-3d-box" class="phone-mockup-frame" data-layout-allow-overflow>
              <div class="phone-dynamic-island"></div>
              <img class="phone-inner-screen" src="assets/09_mobile_tutor_card_detail.png" alt="Профиль репетитора" />
            </div>

            <!-- Spatial Depth Badges -->
            <div id="ft-verified" class="floating-3d-tag tag-pos-verified" data-layout-allow-overflow>
              <span>✓</span> Диплом проверен
            </div>
            <div id="ft-rating" class="floating-3d-tag tag-pos-rating" data-layout-allow-overflow>
              <span>⭐ 5.0</span> (48 отзывов)
            </div>
            <div id="ft-price" class="floating-3d-tag tag-pos-price" data-layout-allow-overflow>
              <span>⚡ 0 BYN</span> комиссии
            </div>

            <!-- Interactive Live Booking Calendar Overlay -->
            <div id="action-box" class="action-demo-box" data-layout-allow-overflow>
              <div class="action-header">
                <div class="action-header-title">Пятница, 24 октября</div>
                <div class="action-sync-tag">Синхронизировано ✓</div>
              </div>
              <div class="action-slots-row">
                <div id="act-slot-1" class="action-slot">
                  <div class="action-slot-time">15:00</div>
                  <div class="action-slot-lbl">Свободно</div>
                </div>
                <div id="act-slot-2" class="action-slot">
                  <div class="action-slot-time">16:30</div>
                  <div class="action-slot-lbl">Свободно</div>
                </div>
                <div id="act-slot-3" class="action-slot">
                  <div class="action-slot-time">18:00</div>
                  <div class="action-slot-lbl">Свободно</div>
                </div>
              </div>

              <div id="act-toast" class="student-booking-toast">
                <div class="toast-icon">⚡</div>
                <div>
                  <div class="toast-title">Занятие подтверждено</div>
                  <div class="toast-desc">Артём записался на 18:00 • 0 BYN комиссии</div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ================= SCENE 05 — THE EMOTIONAL PAYOFF (13.0s - 17.0s) ================= -->
        <div id="scene5" class="scene">
          <div class="payoff-wrap">
            <div id="payoff-badge" class="pill-badge" style="margin-bottom: 36px;">
              <div class="dot"></div>
              <span>Философия Edusfera</span>
            </div>

            <div id="po-slogan-1" class="payoff-slogan-line dark" data-layout-allow-occlusion>НЕ ЗУБРИ.</div>
            <div id="po-slogan-2" class="payoff-slogan-line purple" data-layout-allow-occlusion>ЗНАЙ.</div>

            <div id="po-divider" class="payoff-divider"></div>

            <h2 id="po-submessage" class="payoff-sub-message">
              БОЛЬШЕ ВРЕМЕНИ УЧЕНИКАМ.
            </h2>

            <p id="po-caption" class="payoff-caption">
              Платформа берёт расписание и запись на себя — вы просто преподаёте.
            </p>
          </div>
        </div>

        <!-- ================= SCENE 06 — THE BRAND FINALE (17.0s - 20.0s) ================= -->
        <div id="scene6" class="scene">
          <div class="finale-wrap">
            <div id="fin-mark" class="finale-brand-mark">
              <img src="assets/logo.svg" alt="Логотип Edusfera" />
            </div>

            <h2 id="fin-name" class="finale-logo-wordmark">EDUSFERA.BY</h2>

            <p id="fin-tagline" class="finale-tagline">
              Ваше время — ученикам.
            </p>

            <div id="fin-features" class="finale-feature-row">
              <div class="feature-capsule">0 BYN комиссии</div>
              <div class="feature-capsule">Авто-НПД</div>
              <div class="feature-capsule">Онлайн-запись</div>
            </div>

            <div id="fin-btn" class="finale-cta-btn">
              <span>Создайте свою витрину</span>
              <span class="cta-arrow">→</span>
            </div>

            <div id="fin-domain" class="finale-domain-badge">
              edusfera.by
            </div>
          </div>
        </div>

      </div><!-- /camera-rig -->

      <!-- Progress Track -->
      <div class="progress-bar-container">
        <div id="timeline-progress" class="progress-bar-fill"></div>
      </div>
    </div>

    <!-- GSAP Master Timeline Engine -->
    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // Continuous 20-second progress bar
      tl.to("#timeline-progress", { width: "100%", duration: 20.0, ease: "none" }, 0);

      // ================= MASTER 3D CAMERA RIG MOVEMENTS =================
      // Continuous camera motion throughout all 20 seconds (never static)
      tl.set("#camera-rig", { z: 0, rotationX: 0, rotationY: 0 }, 0);

      // 0.0 - 2.5s: Kinetic Hook push into the typography
      tl.to("#camera-rig", { z: 100, rotationX: 4, duration: 2.5, ease: "power2.inOut" }, 0);

      // 2.5 - 5.0s: The Pain cluster view with isometric tension
      tl.to("#camera-rig", { z: 40, rotationY: -5, rotationX: 2, duration: 2.5, ease: "power2.out" }, 2.5);

      // 5.0 - 8.0s: Transformation & Phone Arrival (3D swoop & settle)
      tl.to("#camera-rig", { z: 60, rotationY: 0, rotationX: 0, duration: 3.0, ease: "power3.out" }, 5.0);

      // 8.0 - 13.0s: Deep Product Macro Push (camera pushes right into the interface)
      tl.to("#camera-rig", { z: 120, rotationX: 1, duration: 5.0, ease: "power1.inOut" }, 8.0);

      // 13.0 - 17.0s: Slogan Payoff pull-back for epic breathing room
      tl.to("#camera-rig", { z: -30, rotationX: 0, rotationY: 0, duration: 4.0, ease: "power2.out" }, 13.0);

      // 17.0 - 20.0s: Brand Finale confident resting position
      tl.to("#camera-rig", { z: 0, duration: 3.0, ease: "power3.out" }, 17.0);


      // ================= SCENE 01 — THE HOOK (0.0s - 2.5s) =================
      tl.set("#scene1", { opacity: 1 }, 0);

      // Beat 1: "ХВАТИТ" (0.0s) - Instant kinetic slam
      tl.fromTo("#h-word-1", 
        { opacity: 0, y: 140, scale: 1.15 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.45, ease: "power4.out" }, 
        0
      );

      // Beat 2: "ТОНУТЬ" (0.75s) - Staggered burst in vivid purple
      tl.fromTo("#h-word-2", 
        { opacity: 0, x: -90, scale: 1.25 }, 
        { opacity: 1, x: 0, scale: 1.0, duration: 0.48, ease: "back.out(1.8)" }, 
        0.75
      );

      // Beat 3: "В РУТИНЕ." (1.45s) - Heavy impact
      tl.fromTo("#h-word-3", 
        { opacity: 0, y: 100, scale: 0.8 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.5, ease: "power4.out" }, 
        1.45
      );

      // Pill badge (1.65s)
      tl.fromTo("#h-pill", 
        { opacity: 0, y: 40, scale: 0.85 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.45, ease: "back.out(1.8)" }, 
        1.65
      );

      // Vector-matched Exit (2.25s - 2.5s): Zoom-through push forward past camera
      tl.to(["#h-word-1", "#h-word-2", "#h-word-3", "#h-pill"], {
        z: 420,
        scale: 1.5,
        opacity: 0,
        duration: 0.35,
        ease: "power3.in"
      }, 2.25);
      tl.to("#scene1", { opacity: 0, duration: 0.2 }, 2.45);


      // ================= SCENE 02 — THE PAIN (2.5s - 5.0s) =================
      tl.set("#scene2", { opacity: 1 }, 2.5);
      tl.fromTo("#p-badge", { opacity: 0, y: -25 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, 2.5);
      tl.fromTo("#p-title", { opacity: 0, y: 35 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 2.6);

      // Cascading chaotic pain cards
      tl.fromTo("#p-card-1", 
        { opacity: 0, x: -100, rotationY: 22, z: -120 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 20, duration: 0.45, ease: "back.out(1.6)" }, 
        2.8
      );
      tl.fromTo("#p-card-2", 
        { opacity: 0, x: 100, rotationY: -22, z: -90 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 30, duration: 0.45, ease: "back.out(1.6)" }, 
        3.2
      );
      tl.fromTo("#p-card-3", 
        { opacity: 0, y: 60, rotationX: 18, z: -70 }, 
        { opacity: 1, y: 0, rotationX: 0, z: 40, duration: 0.45, ease: "back.out(1.6)" }, 
        3.6
      );
      tl.fromTo("#p-banner", 
        { opacity: 0, scale: 0.8, y: 30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.45, ease: "back.out(1.8)" }, 
        4.0
      );

      // Controlled Collapse & Snap into singularity (4.7s - 5.0s)
      tl.to(["#p-card-1", "#p-card-2", "#p-card-3", "#p-banner"], {
        scale: 0.3,
        z: -250,
        opacity: 0,
        duration: 0.35,
        ease: "power3.in"
      }, 4.7);
      tl.to("#scene2", { opacity: 0, duration: 0.2 }, 4.9);


      // ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION (5.0s - 13.0s) =================
      tl.set("#scene3", { opacity: 1 }, 5.0);
      tl.fromTo("#t-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, 5.0);
      tl.fromTo("#t-title", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 5.1);

      // Smartphone swoops in from the singularity with spatial rotation and settling motion
      tl.fromTo("#phone-3d-box", 
        { opacity: 0, y: 360, rotationY: 28, rotationX: 18, z: -350, scale: 0.7 }, 
        { opacity: 1, y: 0, rotationY: -6, rotationX: 4, z: 20, scale: 1.0, duration: 1.25, ease: "power3.out" }, 
        5.1
      );

      // Floating spatial depth badges emerge
      tl.fromTo("#ft-verified", 
        { opacity: 0, scale: 0.4, z: -100, x: 60 }, 
        { opacity: 1, scale: 1.0, z: 120, x: 0, duration: 0.45, ease: "back.out(2)" }, 
        5.75
      );
      tl.fromTo("#ft-rating", 
        { opacity: 0, scale: 0.4, z: -100, x: -60 }, 
        { opacity: 1, scale: 1.0, z: 140, x: 0, duration: 0.45, ease: "back.out(2)" }, 
        6.15
      );
      tl.fromTo("#ft-price", 
        { opacity: 0, scale: 0.4, z: -100, y: 40 }, 
        { opacity: 1, scale: 1.0, z: 160, y: 0, duration: 0.45, ease: "back.out(2)" }, 
        6.55
      );

      // ---- Beat 4A: Focus on digital showcase (8.0s) ----
      tl.to("#phone-3d-box", { rotationY: 0, rotationX: 0, scale: 1.06, duration: 0.8, ease: "power2.inOut" }, 8.0);
      tl.set("#t-badge-text", { textContent: "Ваша цифровая витрина" }, 8.0);
      tl.set("#t-title-line1", { textContent: "Профиль преподавателя" }, 8.0);
      tl.set("#t-title-line2", { textContent: "с гарантией доверия" }, 8.0);

      // ---- Beat 4B: Transition into interactive calendar booking (9.6s) ----
      tl.set("#t-badge-text", { textContent: "Запись на занятия" }, 9.6);
      tl.set("#t-title-line1", { textContent: "Свободные слоты" }, 9.6);
      tl.set("#t-title-line2", { textContent: "в 1 клик" }, 9.6);

      // Dock outer badges to focus attention on booking
      tl.to(["#ft-verified", "#ft-rating", "#ft-price"], { opacity: 0, scale: 0.7, duration: 0.3 }, 9.4);

      // Reveal live action booking calendar
      tl.fromTo("#action-box", 
        { opacity: 0, y: 90, scale: 0.88, z: 80 }, 
        { opacity: 1, y: 0, scale: 1.0, z: 110, duration: 0.55, ease: "back.out(1.6)" }, 
        9.6
      );

      // Interactive slot selection animation on slot 3 (18:00) at 10.5s
      tl.to("#act-slot-3", { scale: 0.92, duration: 0.12, ease: "power1.in" }, 10.45);
      tl.to("#act-slot-3", { 
        scale: 1.08, 
        backgroundColor: "#c6ff33", 
        borderColor: "#0e0f10", 
        duration: 0.22, 
        ease: "back.out(2)" 
      }, 10.57);
      tl.set("#act-slot-3 .action-slot-lbl", { textContent: "Забронировано ✓", color: "#0e0f10" }, 10.57);

      // ---- Beat 4C: Booking confirmed toast (11.2s) ----
      tl.set("#t-badge-text", { textContent: "Меньше рутины" }, 11.2);
      tl.set("#t-title-line1", { textContent: "Уроки подтверждаются" }, 11.2);
      tl.set("#t-title-line2", { textContent: "автоматически" }, 11.2);

      tl.fromTo("#act-toast", 
        { opacity: 0, y: 35, scale: 0.85 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.5, ease: "back.out(1.8)" }, 
        11.2
      );

      // Scene 3 & 4 Out (Z-axis push forward into Emotional Payoff)
      tl.to(["#phone-3d-box", "#action-box"], { scale: 1.55, z: 420, opacity: 0, duration: 0.45, ease: "power2.in" }, 12.65);
      tl.to("#scene3", { opacity: 0, duration: 0.25 }, 12.85);


      // ================= SCENE 05 — THE EMOTIONAL PAYOFF (13.0s - 17.0s) =================
      tl.set("#scene5", { opacity: 1 }, 13.0);
      tl.fromTo("#payoff-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, 13.0);

      // Hero Slogan: "НЕ ЗУБРИ."
      tl.fromTo("#po-slogan-1", 
        { opacity: 0, scale: 0.85, y: -30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.6, ease: "power3.out" }, 
        13.1
      );

      // Hero Slogan: "ЗНАЙ."
      tl.fromTo("#po-slogan-2", 
        { opacity: 0, scale: 1.35, z: 90 }, 
        { opacity: 1, scale: 1.0, z: 0, duration: 0.65, ease: "back.out(1.8)" }, 
        13.7
      );

      // Divider line
      tl.fromTo("#po-divider", 
        { width: 0, opacity: 0 }, 
        { width: 140, opacity: 1, duration: 0.5, ease: "power2.out" }, 
        14.2
      );

      // "БОЛЬШЕ ВРЕМЕНИ УЧЕНИКАМ."
      tl.fromTo("#po-submessage", 
        { opacity: 0, y: 35 }, 
        { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, 
        14.6
      );

      // Caption
      tl.fromTo("#po-caption", 
        { opacity: 0, y: 20 }, 
        { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 
        15.1
      );

      // Vector-matched Exit (Upward elevation handoff at 16.7s - 17.0s)
      tl.to("#scene5", { y: -160, opacity: 0, duration: 0.35, ease: "power2.in" }, 16.65);


      // ================= SCENE 06 — THE BRAND FINALE (17.0s - 20.0s) =================
      tl.set("#scene6", { opacity: 1 }, 17.0);

      // 3D Brand Logo Emblem locks in
      tl.fromTo("#fin-mark", 
        { opacity: 0, scale: 0.35, rotationY: -180, z: -200, y: 100 }, 
        { opacity: 1, scale: 1.0, rotationY: 0, z: 40, y: 0, duration: 0.8, ease: "back.out(2)" }, 
        17.05
      );

      // Wordmark, tagline, features
      tl.fromTo("#fin-name", { opacity: 0, y: 30, scale: 0.92 }, { opacity: 1, y: 0, scale: 1.0, duration: 0.55, ease: "power3.out" }, 17.3);
      tl.fromTo("#fin-tagline", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.45, ease: "power2.out" }, 17.55);

      tl.fromTo(".feature-capsule", 
        { opacity: 0, y: 20, scale: 0.85 }, 
        { opacity: 1, y: 0, scale: 1.0, stagger: 0.08, duration: 0.4, ease: "back.out(1.6)" }, 
        17.75
      );

      // Confident CTA button
      tl.fromTo("#fin-btn", 
        { opacity: 0, scale: 0.82, y: 30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.55, ease: "back.out(1.8)" }, 
        18.05
      );
      tl.fromTo("#fin-domain", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 18.35);

      // Subtle CTA arrow pulse to keep viewer engaged till 20.0s
      tl.to(".cta-arrow", { x: 8, repeat: 3, yoyo: true, duration: 0.28, ease: "power1.inOut" }, 18.55);

      // Register master timeline with HyperFrames
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
