<!doctype html>
<html lang="ru" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>EDUSFERA.BY — Платформа для репетиторов</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

      @font-face {
        font-family: 'Rimma Sans';
        src: url('assets/Rimma_sans-Bold.ttf') format('truetype');
        font-weight: 700;
        font-style: normal;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #0e0f10;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #0e0f10;
        -webkit-font-smoothing: antialiased;
      }

      #root {
        position: relative;
        width: 100%;
        height: 100%;
        background: #ffffff;
        overflow: hidden;
        perspective: 1400px;
        transform-style: preserve-3d;
      }

      /* 3D Master Camera Rig */
      #camera-rig {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        will-change: transform;
      }

      /* Ambient Background Elements */
      .ambient-canvas {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }

      .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.75;
        will-change: transform;
      }

      .orb-purple {
        top: -100px;
        right: -80px;
        width: 750px;
        height: 750px;
        background: radial-gradient(circle, rgba(125, 57, 235, 0.32) 0%, rgba(125, 57, 235, 0) 70%);
      }

      .orb-lime {
        bottom: 100px;
        left: -120px;
        width: 780px;
        height: 780px;
        background: radial-gradient(circle, rgba(198, 255, 51, 0.38) 0%, rgba(198, 255, 51, 0) 70%);
      }

      .orb-coral {
        top: 35%;
        right: -100px;
        width: 650px;
        height: 650px;
        background: radial-gradient(circle, rgba(217, 38, 62, 0.20) 0%, rgba(217, 38, 62, 0) 70%);
      }

      /* Subtle geometric grid */
      .grid-pattern {
        position: absolute;
        inset: -200px;
        background-size: 54px 54px;
        background-image: 
          linear-gradient(to right, rgba(14, 15, 16, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(14, 15, 16, 0.04) 1px, transparent 1px);
        mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
        pointer-events: none;
        z-index: 2;
      }

      /* Base Scene Layer */
      .scene {
        position: absolute;
        inset: 0;
        width: 1080px;
        height: 1920px;
        padding: 96px 64px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transform-style: preserve-3d;
      }

      /* Glassmorphism Badges */
      .pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 30px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(218, 219, 226, 0.9);
        border-radius: 100px;
        box-shadow: 0 8px 24px rgba(14, 15, 16, 0.06);
        align-self: flex-start;
      }

      .pill-badge .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #7d39eb;
        box-shadow: 0 0 12px rgba(125, 57, 235, 0.8);
      }

      .pill-badge span {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #7d39eb;
      }

      /* Typography Classes */
      .display-title {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 92px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: #0e0f10;
        margin-top: 36px;
      }

      .display-title .highlight-purple {
        color: #7d39eb;
        display: inline-block;
      }

      .display-title .highlight-coral {
        color: #d9263e;
        display: inline-block;
      }

      .subtitle-text {
        font-size: 34px;
        font-weight: 500;
        line-height: 1.4;
        color: #4b5563;
        margin-top: 24px;
        max-width: 900px;
      }

      /* ================= SCENE 01 — HOOK SPECIFICS ================= */
      .hook-wrap {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        text-align: center;
        transform-style: preserve-3d;
      }

      .hook-word {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 148px;
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: -0.04em;
        display: block;
        transform-style: preserve-3d;
      }

      .hook-word.word-1 {
        color: #0e0f10;
      }

      .hook-word.word-2 {
        color: #7d39eb;
        font-size: 160px;
      }

      .hook-word.word-3 {
        color: #d9263e;
        font-size: 152px;
      }

      .hook-sub-pill {
        margin-top: 48px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        border-radius: 100px;
        background: #0e0f10;
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        box-shadow: 0 16px 36px rgba(14, 15, 16, 0.2);
      }

      .hook-sub-pill .fire-icon {
        color: #c6ff33;
        font-size: 28px;
      }

      /* ================= SCENE 02 — THE PAIN SPECIFICS ================= */
      .pain-stage {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        transform-style: preserve-3d;
      }

      .pain-cards-cluster {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-top: auto;
        margin-bottom: 80px;
        width: 100%;
        transform-style: preserve-3d;
      }

      .pain-card-item {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 32px 36px;
        background: #ffffff;
        border-radius: 28px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
        transform-style: preserve-3d;
      }

      .pain-icon-badge {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        flex-shrink: 0;
      }

      .pain-icon-badge.red {
        background: #ffe9eb;
        color: #d9263e;
      }

      .pain-icon-badge.blue {
        background: #eff6ff;
        color: #2563eb;
      }

      .pain-icon-badge.amber {
        background: #fef3c7;
        color: #b45309;
      }

      .pain-card-text {
        font-size: 30px;
        font-weight: 600;
        color: #111827;
      }

      .pain-impact-banner {
        padding: 24px 36px;
        border-radius: 24px;
        background: #0e0f10;
        color: #ffffff;
        font-size: 30px;
        font-weight: 700;
        text-align: center;
        box-shadow: 0 16px 36px rgba(14, 15, 16, 0.2);
        margin-top: 10px;
      }

      /* ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION ================= */
      .phone-showcase-stage {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform-style: preserve-3d;
        margin-top: 20px;
      }

      .phone-mockup-frame {
        width: 720px;
        height: 1080px;
        background: #ffffff;
        border-radius: 56px;
        padding: 16px;
        box-shadow: 0 45px 100px -20px rgba(125, 57, 235, 0.32), 0 25px 50px rgba(0, 0, 0, 0.12);
        border: 12px solid #111827;
        position: relative;
        overflow: hidden;
        transform-style: preserve-3d;
      }

      .phone-dynamic-island {
        position: absolute;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        width: 170px;
        height: 32px;
        background: #111827;
        border-radius: 20px;
        z-index: 20;
      }

      .phone-inner-screen {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        border-radius: 40px;
      }

      /* Floating depth badges */
      .floating-3d-tag {
        position: absolute;
        z-index: 35;
        padding: 18px 30px;
        border-radius: 100px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 20px 45px rgba(14, 15, 16, 0.16);
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 26px;
        font-weight: 700;
        transform-style: preserve-3d;
      }

      .tag-pos-verified {
        top: 160px;
        right: 10px;
        color: #047857;
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .tag-pos-rating {
        bottom: 220px;
        left: 10px;
        color: #111827;
      }

      .tag-pos-price {
        top: 500px;
        left: 10px;
        background: #7d39eb;
        color: #c6ff33;
        border-color: #6827d6;
      }

      /* Scene 4 in-action overlay */
      .action-demo-box {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        width: 660px;
        transform-style: preserve-3d;
        z-index: 40;
      }

      .action-calendar-card {
        background: #ffffff;
        border-radius: 32px;
        padding: 32px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.08);
      }

      .action-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .action-header-title {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
      }

      .action-sync-tag {
        font-size: 18px;
        font-weight: 700;
        color: #7d39eb;
        background: #f3e8ff;
        padding: 6px 16px;
        border-radius: 100px;
      }

      .action-slots-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .action-slot {
        padding: 20px 12px;
        border-radius: 18px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        text-align: center;
      }

      .action-slot-time {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
      }

      .action-slot-lbl {
        font-size: 16px;
        font-weight: 600;
        color: #4b5563;
        margin-top: 4px;
      }

      /* Student push toast */
      .student-booking-toast {
        margin-top: 16px;
        background: #ffffff;
        border-radius: 28px;
        padding: 24px 30px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 25px 50px rgba(125, 57, 235, 0.18);
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .toast-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: #7d39eb;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        flex-shrink: 0;
      }

      .toast-title {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
      }

      .toast-desc {
        font-size: 19px;
        color: #4b5563;
        margin-top: 2px;
      }

      /* ================= SCENE 05 — THE EMOTIONAL PAYOFF ================= */
      .payoff-wrap {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        text-align: center;
        padding: 0 20px;
        transform-style: preserve-3d;
      }

      .payoff-slogan-line {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 130px;
        font-weight: 700;
        line-height: 1.0;
        letter-spacing: -0.04em;
        display: block;
      }

      .payoff-slogan-line.purple {
        color: #7d39eb;
      }

      .payoff-slogan-line.dark {
        color: #0e0f10;
      }

      .payoff-divider {
        width: 140px;
        height: 8px;
        background: #c6ff33;
        border-radius: 10px;
        margin: 48px auto;
        box-shadow: 0 0 24px rgba(198, 255, 51, 0.6);
      }

      .payoff-sub-message {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 58px;
        font-weight: 700;
        color: #0e0f10;
        letter-spacing: -0.02em;
        line-height: 1.15;
        max-width: 860px;
      }

      .payoff-caption {
        font-size: 30px;
        font-weight: 500;
        color: #4b5563;
        margin-top: 28px;
        max-width: 800px;
        line-height: 1.45;
      }

      /* ================= SCENE 06 — THE BRAND FINALE ================= */
      .finale-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: 240px;
        transform-style: preserve-3d;
      }

      .finale-brand-mark {
        width: 190px;
        height: 190px;
        border-radius: 46px;
        background: #ffffff;
        box-shadow: 0 30px 70px rgba(125, 57, 235, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
        border: 2px solid #ede9fe;
        transform-style: preserve-3d;
      }

      .finale-brand-mark img {
        width: 125px;
        height: 125px;
      }

      .finale-logo-wordmark {
        font-family: 'Rimma Sans', sans-serif;
        font-size: 114px;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #0e0f10;
      }

      .finale-tagline {
        font-size: 34px;
        font-weight: 600;
        color: #4b5563;
        margin-top: 18px;
        max-width: 820px;
      }

      .finale-cta-btn {
        margin-top: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 30px 64px;
        border-radius: 100px;
        background: #0e0f10;
        color: #ffffff;
        font-size: 32px;
        font-weight: 700;
        box-shadow: 0 20px 50px rgba(14, 15, 16, 0.25);
        border: none;
        transform-style: preserve-3d;
      }

      .finale-cta-btn .cta-arrow {
        color: #c6ff33;
        font-size: 36px;
      }

      .finale-domain-badge {
        margin-top: 40px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        background: #f3f4f6;
        border-radius: 100px;
        font-size: 32px;
        font-weight: 800;
        color: #7d39eb;
        letter-spacing: 0.05em;
        border: 2px solid #e5e7eb;
      }

      .finale-feature-row {
        display: flex;
        gap: 16px;
        margin-top: 36px;
      }

      .feature-capsule {
        padding: 10px 22px;
        border-radius: 100px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        font-size: 20px;
        font-weight: 700;
        color: #374151;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
      }

      /* Progress Bar */
      .progress-bar-container {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: rgba(0, 0, 0, 0.04);
        z-index: 100;
      }

      .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(to right, #7d39eb, #d9263e, #c6ff33);
      }
    </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="20"
      data-width="1080"
      data-height="1920"
    >
      <!-- Audio Element for Dynamic Track inside composition root -->
      <audio id="bgm" src="audio_track.mp3" data-start="0" data-duration="20"></audio>

      <!-- Ambient Mesh Background -->
      <div class="ambient-canvas" data-layout-allow-overflow>
        <div class="ambient-orb orb-purple" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-lime" data-layout-allow-overflow></div>
        <div class="ambient-orb orb-coral" data-layout-allow-overflow></div>
      </div>
      <div class="grid-pattern"></div>

      <!-- MASTER 3D CAMERA RIG -->
      <div id="camera-rig">

        <!-- ================= SCENE 01 — THE HOOK (0.0s - 2.5s) ================= -->
        <div id="scene1" class="scene">
          <div class="hook-wrap">
            <div id="h-word-1" class="hook-word word-1" data-layout-allow-overflow data-layout-allow-occlusion>ХВАТИТ</div>
            <div id="h-word-2" class="hook-word word-2" data-layout-allow-overflow data-layout-allow-occlusion>ТОНУТЬ</div>
            <div id="h-word-3" class="hook-word word-3" data-layout-allow-overflow data-layout-allow-occlusion>В РУТИНЕ.</div>
            <div id="h-pill" class="hook-sub-pill" data-layout-allow-overflow>
              <span class="fire-icon">⚡</span>
              <span>EDUSFERA ДЛЯ РЕПЕТИТОРОВ</span>
            </div>
          </div>
        </div>

        <!-- ================= SCENE 02 — THE PAIN (2.5s - 5.0s) ================= -->
        <div id="scene2" class="scene">
          <div class="pain-stage">
            <div>
              <div id="p-badge" class="pill-badge">
                <div class="dot"></div>
                <span>Знакомая ситуация?</span>
              </div>
              <h2 id="p-title" class="display-title">
                Уроки. Сообщения.<br />
                <span class="highlight-coral">Расписание.</span>
              </h2>
            </div>

            <div class="pain-cards-cluster">
              <div id="p-card-1" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge blue">💬</div>
                <div class="pain-card-text">«Перенесите урок на 19:30, пожалуйста!»</div>
              </div>
              <div id="p-card-2" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge red">📅</div>
                <div class="pain-card-text">Накладка: 2 ученика записались на 17:00</div>
              </div>
              <div id="p-card-3" class="pain-card-item" data-layout-allow-overflow>
                <div class="pain-icon-badge amber">💳</div>
                <div class="pain-card-text">Снова забыли скинуть чек об оплате...</div>
              </div>

              <div id="p-banner" class="pain-impact-banner" data-layout-allow-overflow>
                СЛИШКОМ МНОГО РУТИНЫ
              </div>
            </div>
          </div>
        </div>

        <!-- ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION (5.0s - 13.0s) ================= -->
        <div id="scene3" class="scene">
          <div>
            <div id="t-badge" class="pill-badge">
              <div class="dot"></div>
              <span id="t-badge-text">Знакомьтесь: Edusfera</span>
            </div>
            <h2 id="t-title" class="display-title">
              <span id="t-title-line1">Ваша цифровая</span><br />
              <span id="t-title-line2" class="highlight-purple">витрина</span>
            </h2>
          </div>

          <div class="phone-showcase-stage">
            <div id="phone-3d-box" class="phone-mockup-frame" data-layout-allow-overflow>
              <div class="phone-dynamic-island"></div>
              <img class="phone-inner-screen" src="assets/tutor_profile.png" alt="Профиль репетитора" />
            </div>

            <!-- Floating 3D badges -->
            <div id="ft-verified" class="floating-3d-tag tag-pos-verified" data-layout-allow-overflow>
              <span>✓</span> Диплом проверен
            </div>
            <div id="ft-rating" class="floating-3d-tag tag-pos-rating" data-layout-allow-overflow>
              <span>⭐ 5.0</span> (48 отзывов)
            </div>
            <div id="ft-price" class="floating-3d-tag tag-pos-price" data-layout-allow-overflow>
              <span>⚡ Ставка: 35 BYN / ч</span>
            </div>

            <!-- Scene 4 in-action calendar overlay -->
            <div id="action-box" class="action-demo-box" data-layout-allow-overflow>
              <div class="action-calendar-card">
                <div class="action-header">
                  <div class="action-header-title">Пятница, 24 октября</div>
                  <div class="action-sync-tag">Синхронизировано ✓</div>
                </div>
                <div class="action-slots-row">
                  <div id="act-slot-1" class="action-slot">
                    <div class="action-slot-time">15:00</div>
                    <div class="action-slot-lbl">Свободно</div>
                  </div>
                  <div id="act-slot-2" class="action-slot">
                    <div class="action-slot-time">16:30</div>
                    <div class="action-slot-lbl">Свободно</div>
                  </div>
                  <div id="act-slot-3" class="action-slot">
                    <div class="action-slot-time">18:00</div>
                    <div class="action-slot-lbl">Свободно</div>
                  </div>
                </div>
              </div>

              <div id="act-toast" class="student-booking-toast">
                <div class="toast-icon">⚡</div>
                <div>
                  <div class="toast-title">Занятие подтверждено</div>
                  <div class="toast-desc">Артём записался на 18:00 • 0 BYN комиссии</div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ================= SCENE 05 — THE EMOTIONAL PAYOFF (13.0s - 17.0s) ================= -->
        <div id="scene5" class="scene">
          <div class="payoff-wrap">
            <div id="payoff-badge" class="pill-badge" style="margin-bottom: 36px;">
              <div class="dot"></div>
              <span>Философия Edusfera</span>
            </div>

            <div id="po-slogan-1" class="payoff-slogan-line dark" data-layout-allow-occlusion>НЕ ЗУБРИ.</div>
            <div id="po-slogan-2" class="payoff-slogan-line purple" data-layout-allow-occlusion>ЗНАЙ.</div>

            <div id="po-divider" class="payoff-divider"></div>

            <h2 id="po-submessage" class="payoff-sub-message">
              БОЛЬШЕ ВРЕМЕНИ УЧЕНИКАМ.
            </h2>

            <p id="po-caption" class="payoff-caption">
              Платформа берёт расписание и отчёты на себя — вы просто преподаёте.
            </p>
          </div>
        </div>

        <!-- ================= SCENE 06 — THE BRAND FINALE (17.0s - 20.0s) ================= -->
        <div id="scene6" class="scene">
          <div class="finale-wrap">
            <div id="fin-mark" class="finale-brand-mark">
              <img src="assets/logo.svg" alt="Логотип Edusfera" />
            </div>

            <h2 id="fin-name" class="finale-logo-wordmark">EDUSFERA.BY</h2>

            <p id="fin-tagline" class="finale-tagline">
              Ваше время — ученикам.
            </p>

            <div id="fin-features" class="finale-feature-row">
              <div class="feature-capsule">0 BYN комиссии</div>
              <div class="feature-capsule">Авто-НПД</div>
              <div class="feature-capsule">Онлайн-запись</div>
            </div>

            <div id="fin-btn" class="finale-cta-btn">
              <span>Создайте свою витрину</span>
              <span class="cta-arrow">→</span>
            </div>

            <div id="fin-domain" class="finale-domain-badge">
              edusfera.by
            </div>
          </div>
        </div>

      </div><!-- /camera-rig -->

      <!-- Bottom Progress Track -->
      <div class="progress-bar-container">
        <div id="timeline-progress" class="progress-bar-fill"></div>
      </div>
    </div>

    <!-- GSAP Master Timeline Controller -->
    <script>
      const tl = gsap.timeline({ paused: true });

      // Continuous 20-second progress bar
      tl.to("#timeline-progress", { width: "100%", duration: 20.0, ease: "none" }, 0);

      // ================= MASTER 3D CAMERA RIG MOVEMENTS =================
      tl.set("#camera-rig", { z: 0, rotationX: 0, rotationY: 0 }, 0);

      // 0.0 - 2.5s: Kinetic Hook push
      tl.to("#camera-rig", { z: 90, rotationX: 4, duration: 2.5, ease: "power2.inOut" }, 0);

      // 2.5 - 5.0s: The Pain cluster view with isometric tension
      tl.to("#camera-rig", { z: 30, rotationY: -4, rotationX: 2, duration: 2.5, ease: "power2.out" }, 2.5);

      // 5.0 - 8.0s: Transformation & Phone Arrival (swoop to 3D angle and settle)
      tl.to("#camera-rig", { z: 50, rotationY: 0, rotationX: 0, duration: 3.0, ease: "power3.out" }, 5.0);

      // 8.0 - 13.0s: Deep Product Fly-through (camera pushes into interface)
      tl.to("#camera-rig", { z: 100, rotationX: 2, duration: 5.0, ease: "power1.inOut" }, 8.0);

      // 13.0 - 17.0s: Slogan Payoff pull-back for epic breathing room
      tl.to("#camera-rig", { z: -40, rotationX: 0, rotationY: 0, duration: 4.0, ease: "power2.out" }, 13.0);

      // 17.0 - 20.0s: Brand Finale confident resting position
      tl.to("#camera-rig", { z: 0, duration: 3.0, ease: "power3.out" }, 17.0);


      // ================= SCENE 01 — THE HOOK (0.0s - 2.5s) =================
      tl.fromTo("#scene1", { opacity: 0 }, { opacity: 1, duration: 0.15 }, 0);

      // Beat 1: "ХВАТИТ" (0.0s)
      tl.fromTo("#h-word-1", 
        { opacity: 0, scale: 0.7, y: -40, z: -100 }, 
        { opacity: 1, scale: 1.0, y: 0, z: 40, duration: 0.45, ease: "back.out(2)" }, 
        0
      );

      // Beat 2: "ТОНУТЬ" (0.75s)
      tl.fromTo("#h-word-2", 
        { opacity: 0, scale: 1.4, x: -60, z: -80 }, 
        { opacity: 1, scale: 1.0, x: 0, z: 50, duration: 0.45, ease: "power3.out" }, 
        0.75
      );

      // Beat 3: "В РУТИНЕ." (1.5s)
      tl.fromTo("#h-word-3", 
        { opacity: 0, scale: 0.6, y: 50, z: -120 }, 
        { opacity: 1, scale: 1.0, y: 0, z: 60, duration: 0.5, ease: "back.out(2.2)" }, 
        1.5
      );
      tl.fromTo("#h-pill", 
        { opacity: 0, y: 30, scale: 0.8 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.4, ease: "back.out(1.6)" }, 
        1.7
      );

      // Hook Out (Slam past camera at 2.3s - 2.5s)
      tl.to(["#h-word-1", "#h-word-2", "#h-word-3", "#h-pill"], {
        z: 450,
        scale: 1.6,
        opacity: 0,
        duration: 0.35,
        ease: "power3.in"
      }, 2.25);
      tl.to("#scene1", { opacity: 0, duration: 0.2 }, 2.45);


      // ================= SCENE 02 — THE PAIN (2.5s - 5.0s) =================
      tl.fromTo("#scene2", { opacity: 0 }, { opacity: 1, duration: 0.2 }, 2.5);
      tl.fromTo("#p-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 2.55);
      tl.fromTo("#p-title", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 2.65);

      // Cascading chaotic pain cards
      tl.fromTo("#p-card-1", 
        { opacity: 0, x: -80, rotationY: 20, z: -100 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 20, duration: 0.45, ease: "back.out(1.5)" }, 
        2.85
      );
      tl.fromTo("#p-card-2", 
        { opacity: 0, x: 80, rotationY: -20, z: -80 }, 
        { opacity: 1, x: 0, rotationY: 0, z: 30, duration: 0.45, ease: "back.out(1.5)" }, 
        3.25
      );
      tl.fromTo("#p-card-3", 
        { opacity: 0, y: 40, rotationX: 15, z: -60 }, 
        { opacity: 1, y: 0, rotationX: 0, z: 40, duration: 0.45, ease: "back.out(1.5)" }, 
        3.65
      );
      tl.fromTo("#p-banner", 
        { opacity: 0, scale: 0.8, y: 30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.4, ease: "back.out(1.8)" }, 
        4.0
      );

      // Collapse and snap transition into Transformation (4.6s - 5.0s)
      tl.to(["#p-card-1", "#p-card-2", "#p-card-3", "#p-banner"], {
        scale: 0.3,
        z: -200,
        opacity: 0,
        duration: 0.35,
        ease: "power3.in"
      }, 4.7);
      tl.to("#scene2", { opacity: 0, duration: 0.2 }, 4.9);


      // ================= SCENE 03 & 04 — TRANSFORMATION & PRODUCT IN ACTION (5.0s - 13.0s) =================
      tl.fromTo("#scene3", { opacity: 0 }, { opacity: 1, duration: 0.25 }, 5.0);
      tl.fromTo("#t-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 5.05);
      tl.fromTo("#t-title", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 5.15);

      // Smartphone swoops in with 3D rotation and settling motion
      tl.fromTo("#phone-3d-box", 
        { opacity: 0, y: 320, rotationY: 26, rotationX: 16, z: -300, scale: 0.75 }, 
        { opacity: 1, y: 0, rotationY: -6, rotationX: 4, z: 20, scale: 1.0, duration: 1.3, ease: "power3.out" }, 
        5.1
      );

      // Floating badges emerge with physical depth
      tl.fromTo("#ft-verified", 
        { opacity: 0, scale: 0.4, z: -100, x: 50 }, 
        { opacity: 1, scale: 1.0, z: 120, x: 0, duration: 0.5, ease: "back.out(2)" }, 
        5.8
      );
      tl.fromTo("#ft-rating", 
        { opacity: 0, scale: 0.4, z: -100, x: -50 }, 
        { opacity: 1, scale: 1.0, z: 140, x: 0, duration: 0.5, ease: "back.out(2)" }, 
        6.2
      );
      tl.fromTo("#ft-price", 
        { opacity: 0, scale: 0.4, z: -100, y: 30 }, 
        { opacity: 1, scale: 1.0, z: 160, y: 0, duration: 0.5, ease: "back.out(2)" }, 
        6.6
      );

      // ---- Beat 4A: Focus on digital showcase (8.0s) ----
      tl.to("#phone-3d-box", { rotationY: 0, rotationX: 0, scale: 1.05, duration: 0.8, ease: "power2.inOut" }, 8.0);
      tl.set("#t-badge-text", { textContent: "Ваша цифровая витрина" }, 8.0);
      tl.set("#t-title-line1", { textContent: "Профиль преподавателя" }, 8.0);
      tl.set("#t-title-line2", { textContent: "с гарантией доверия" }, 8.0);

      // ---- Beat 4B: Transition into interactive calendar booking (9.6s) ----
      tl.set("#t-badge-text", { textContent: "Запись на занятия" }, 9.6);
      tl.set("#t-title-line1", { textContent: "Свободные слоты" }, 9.6);
      tl.set("#t-title-line2", { textContent: "в 1 клик" }, 9.6);

      // Hide phone outer badges to focus on calendar
      tl.to(["#ft-verified", "#ft-rating", "#ft-price"], { opacity: 0, scale: 0.7, duration: 0.3 }, 9.4);

      // Reveal action calendar demo box
      tl.fromTo("#action-box", 
        { opacity: 0, y: 80, scale: 0.9, z: 80 }, 
        { opacity: 1, y: 0, scale: 1.0, z: 100, duration: 0.6, ease: "back.out(1.6)" }, 
        9.6
      );

      // Interactive slot selection animation on slot 3 (18:00) at 10.5s
      tl.to("#act-slot-3", { scale: 0.92, duration: 0.12, ease: "power1.in" }, 10.45);
      tl.to("#act-slot-3", { 
        scale: 1.06, 
        backgroundColor: "#c6ff33", 
        borderColor: "#0e0f10", 
        duration: 0.22, 
        ease: "back.out(2)" 
      }, 10.57);
      tl.set("#act-slot-3 .action-slot-lbl", { textContent: "Забронировано ✓", color: "#0e0f10" }, 10.57);

      // ---- Beat 4C: Booking confirmed toast (11.2s) ----
      tl.set("#t-badge-text", { textContent: "Меньше рутины" }, 11.2);
      tl.set("#t-title-line1", { textContent: "Уроки подтверждаются" }, 11.2);
      tl.set("#t-title-line2", { textContent: "автоматически" }, 11.2);

      tl.fromTo("#act-toast", 
        { opacity: 0, y: 30, scale: 0.85 }, 
        { opacity: 1, y: 0, scale: 1.0, duration: 0.5, ease: "back.out(1.8)" }, 
        11.2
      );

      // Scene 3 & 4 Out (Z-axis push forward into Emotional Payoff)
      tl.to(["#phone-3d-box", "#action-box"], { scale: 1.5, z: 380, opacity: 0, duration: 0.45, ease: "power2.in" }, 12.65);
      tl.to("#scene3", { opacity: 0, duration: 0.3 }, 12.85);


      // ================= SCENE 05 — THE EMOTIONAL PAYOFF (13.0s - 17.0s) =================
      tl.fromTo("#scene5", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 13.0);
      tl.fromTo("#payoff-badge", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 13.05);

      // Hero Slogan: "НЕ ЗУБРИ."
      tl.fromTo("#po-slogan-1", 
        { opacity: 0, scale: 0.85, y: -30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.6, ease: "power3.out" }, 
        13.1
      );

      // Hero Slogan: "ЗНАЙ."
      tl.fromTo("#po-slogan-2", 
        { opacity: 0, scale: 1.3, z: 80 }, 
        { opacity: 1, scale: 1.0, z: 0, duration: 0.65, ease: "back.out(1.8)" }, 
        13.7
      );

      tl.fromTo("#po-divider", 
        { width: 0, opacity: 0 }, 
        { width: 140, opacity: 1, duration: 0.5, ease: "power2.out" }, 
        14.2
      );

      // "БОЛЬШЕ ВРЕМЕНИ УЧЕНИКАМ."
      tl.fromTo("#po-submessage", 
        { opacity: 0, y: 30 }, 
        { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, 
        14.6
      );

      tl.fromTo("#po-caption", 
        { opacity: 0, y: 20 }, 
        { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 
        15.1
      );

      // Scene 5 Out
      tl.to("#scene5", { scale: 0.94, opacity: 0, duration: 0.4, ease: "power2.in" }, 16.65);


      // ================= SCENE 06 — THE BRAND FINALE (17.0s - 20.0s) =================
      tl.fromTo("#scene6", { opacity: 0 }, { opacity: 1, duration: 0.35 }, 17.0);

      // 3D Brand Logo Emblem locks in
      tl.fromTo("#fin-mark", 
        { opacity: 0, scale: 0.3, rotationY: -180, z: -200 }, 
        { opacity: 1, scale: 1.0, rotationY: 0, z: 40, duration: 0.8, ease: "back.out(2)" }, 
        17.1
      );

      // Wordmark, tagline, features
      tl.fromTo("#fin-name", { opacity: 0, y: 30, scale: 0.9 }, { opacity: 1, y: 0, scale: 1.0, duration: 0.6, ease: "power3.out" }, 17.35);
      tl.fromTo("#fin-tagline", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 17.6);

      tl.fromTo(".feature-capsule", 
        { opacity: 0, y: 20, scale: 0.8 }, 
        { opacity: 1, y: 0, scale: 1.0, stagger: 0.1, duration: 0.4, ease: "back.out(1.6)" }, 
        17.8
      );

      // Confident CTA button
      tl.fromTo("#fin-btn", 
        { opacity: 0, scale: 0.8, y: 30 }, 
        { opacity: 1, scale: 1.0, y: 0, duration: 0.6, ease: "back.out(1.8)" }, 
        18.1
      );
      tl.fromTo("#fin-domain", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 18.4);

      // Subtle CTA arrow pulse to keep eye engaged till 20.0s
      tl.to(".cta-arrow", { x: 8, repeat: 3, yoyo: true, duration: 0.28, ease: "power1.inOut" }, 18.6);

      // Register master timeline
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
